# Copy to .env.local for local dev (Vite loads it automatically).

# Where the FastAPI backend is reachable. In production this is served
# from the same origin (FastAPI serves the built frontend), so this only
# matters for local dev against `uvicorn` running separately from Vite.
VITE_API_BASE_URL=http://localhost:8000

# Auth is handled entirely by the backend (local email/password, OIDC,
# and/or SAML — see shared/config.py's auth_enable_* settings and
# .env.example at the repo root). Nothing auth-related is configured
# here anymore.
