# Copy to .env for local development (docker-compose reads this too)

# Default is SQLite (a single file, nothing else to run) — see
# shared/config.py. Uncomment to leave it unset, or point it at Postgres
# once you actually need it (needs requirements-postgres.txt installed —
# already baked into both Dockerfiles):
# DATABASE_URL=postgresql+psycopg://watch:watch@localhost:5432/watch

# SMTP (Resend, or any SMTP-compatible provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com

# Auth providers — enable any combination. Local email/password needs no
# other config. See web/api/auth.py, web/api/saml_auth.py.
AUTH_ENABLE_LOCAL=true
AUTH_ENABLE_OIDC=false
AUTH_ENABLE_SAML=false

# This server's own externally-reachable URL (used in verification email
# links). Set to your real domain in production.
PUBLIC_BASE_URL=http://localhost:8000

# External OIDC provider (only used if AUTH_ENABLE_OIDC=true) — Supabase
# Auth, Keycloak, Auth0, Azure AD via OIDC, etc.
AUTH_JWKS_URL=
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=authenticated
AUTH_OIDC_ALGORITHMS=ES256,RS256

# SAML 2.0 SSO (only used if AUTH_ENABLE_SAML=true) — one IdP per
# deployment. Get these three from your IdP's app config (Okta, Azure AD,
# etc.); SAML_SP_BASE_URL must match what you register as the SP with
# the IdP exactly.
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_X509_CERT=
SAML_SP_BASE_URL=http://localhost:8000
SAML_FRONTEND_REDIRECT_URL=/

# Stripe (reserved for a future paid tier; unused in the open-source build)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
